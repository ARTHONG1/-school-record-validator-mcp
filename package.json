{
  "name": "school-record-validator-mcp",
  "version": "0.2.0",
  "description": "Evidence-backed local and remote MCP server for 2026 Korean elementary school-record validation.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "school-record-validator-mcp": "dist/index.js",
    "school-record-validator-mcp-remote": "dist/remote.js"
  },
  "files": [
    "dist",
    "data",
    "docs",
    "sources/manifest.json",
    "README.md",
    "ATTRIBUTION.md",
    "DATA_LICENSE.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "build:ingest": "tsc -p tsconfig.ingest.json",
    "ingest": "npm run build:ingest && node .ingest-dist/scripts/build-corpus.js",
    "verify:sources": "npm run build:ingest && node .ingest-dist/scripts/verify-sources.js",
    "snapshot:sources": "npm run build:ingest && node .ingest-dist/scripts/verify-sources.js --snapshot",
    "seal:data": "npm run build:ingest && node .ingest-dist/scripts/seal-data.js",
    "start": "node dist/index.js",
    "start:remote": "node dist/remote.js",
    "test": "node --test \"tests/*.test.ts\"",
    "test:file": "node --test",
    "test:e2e": "node --test tests/e2e/end-to-end.test.ts tests/remote-server.test.ts",
    "verify:site": "node scripts/verify-site.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ingest.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.18.8",
    "@types/pako": "2.0.4",
    "@xmldom/xmldom": "0.8.13",
    "cfb": "1.2.2",
    "pako": "2.1.0",
    "pdfjs-dist": "5.6.205",
    "typescript": "5.9.3"
  }
}
